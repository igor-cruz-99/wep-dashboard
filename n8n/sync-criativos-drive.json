{
  "name": "[WEP] Criativos Drive → Storage",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 20
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "id": "c2000000-0000-4000-8000-000000000001",
      "name": "A cada 20 min"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://sfxbzfaxbbdjzuhzzrjc.supabase.co/rest/v1/rpc/fn_criativos_drive_pendentes",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Profile",
              "value": "mkt_wep"
            },
            {
              "name": "Accept-Profile",
              "value": "mkt_wep"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"p_limit\": 10}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        220,
        0
      ],
      "id": "c2000000-0000-4000-8000-000000000002",
      "name": "Buscar pendentes",
      "credentials": {
        "supabaseApi": {
          "id": "5XZTPxZZN2ZzL1vn",
          "name": "Supabase PROD"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// A RPC devolve um array; dependendo da versão o n8n entrega tudo num item só.\n// Normaliza para 1 item por criativo e calcula o nome do arquivo no Storage.\nconst out = [];\nfor (const item of $input.all()) {\n  const j = item.json;\n  const lista = Array.isArray(j) ? j : (Array.isArray(j.data) ? j.data : [j]);\n  for (const r of lista) {\n    if (!r || !r.ad_name || !r.drive_file_id) continue;\n    // Storage não aceita acento nem espaço.\n    const slug = String(r.ad_name)\n      .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n      .toLowerCase().replace(/[^a-z0-9]+/g, '_').replace(/^_+|_+$/g, '');\n    out.push({ json: { ad_name: r.ad_name, tipo: r.tipo, drive_file_id: r.drive_file_id, slug } });\n  }\n}\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "id": "c2000000-0000-4000-8000-000000000003",
      "name": "Normalizar"
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.drive_file_id }}"
        },
        "options": {
          "binaryPropertyName": "data"
        }
      },
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        880,
        0
      ],
      "id": "c2000000-0000-4000-8000-000000000004",
      "name": "Baixar do Drive",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://sfxbzfaxbbdjzuhzzrjc.supabase.co/storage/v1/object/ad-creatives/{{ $('Um por vez').item.json.slug }}.{{ $binary.data.mimeType.startsWith('video/') ? 'mp4' : ($binary.data.mimeType.includes('png') ? 'png' : ($binary.data.mimeType.includes('gif') ? 'gif' : 'jpg')) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-upsert",
              "value": "true"
            }
          ]
        },
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "data",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1100,
        -110
      ],
      "id": "c2000000-0000-4000-8000-000000000006",
      "name": "Upload Storage",
      "credentials": {
        "supabaseApi": {
          "id": "5XZTPxZZN2ZzL1vn",
          "name": "Supabase PROD"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// SÓ grava a URL depois que o Storage confirmou o upload. Era esse o bug do\n// workflow antigo da Meta: montava a URL por convenção e gravava mesmo quando\n// o upload falhava — o bucket ficou com ZERO .mp4 e o banco com 130\n// storage_video_url apontando para 404.\n//\n// O destino é recalculado aqui a partir do mimeType do download, porque o\n// binário não passa mais por Code node (era o que estourava o payload).\nconst ctx = $('Um por vez').item.json;\nconst mime = $('Baixar do Drive').item.binary?.data?.mimeType || 'application/octet-stream';\nconst ehVideo = mime.startsWith('video/');\nconst ext = ehVideo\n  ? 'mp4'\n  : (mime.includes('png') ? 'png' : (mime.includes('gif') ? 'gif' : 'jpg'));\nconst destino = ctx.slug + '.' + ext;\n\nconst resp = $input.item.json ?? {};\nconst ok = resp.Key || resp.Id || resp.key || resp.id;\n\nif (!ok) {\n  return {\n    json: {\n      ad_name: ctx.ad_name,\n      patch: {\n        erro: ('upload sem confirmacao: ' + JSON.stringify(resp)).slice(0, 300),\n        synced_at: new Date().toISOString(),\n      },\n    },\n  };\n}\n\nconst publica =\n  'https://sfxbzfaxbbdjzuhzzrjc.supabase.co/storage/v1/object/public/ad-creatives/' + destino;\nconst patch = ehVideo\n  ? { storage_video_url: publica, synced_at: new Date().toISOString(), erro: null }\n  : { storage_url: publica, synced_at: new Date().toISOString(), erro: null };\n\nreturn { json: { ad_name: ctx.ad_name, patch } };",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        -110
      ],
      "id": "c2000000-0000-4000-8000-000000000007",
      "name": "Confirmar upload"
    },
    {
      "parameters": {
        "jsCode": "// Ramo de falha do download (arquivo removido do Drive, sem permissão, queda de\n// rede). Marca synced_at para o mesmo criativo não ser tentado a cada 20 min\n// para sempre — o motivo fica na coluna erro para inspeção.\nconst ctx = $('Um por vez').item.json ?? {};\nconst j = $input.item.json ?? {};\nconst msg =\n  j.error?.message || j.message || (typeof j.error === 'string' ? j.error : '') || 'falha ao baixar do Drive';\n\nreturn {\n  json: {\n    ad_name: ctx.ad_name ?? j.ad_name ?? null,\n    patch: { erro: String(msg).slice(0, 300), synced_at: new Date().toISOString() },\n  },\n};",
        "mode": "runOnceForEachItem"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        110
      ],
      "id": "c2000000-0000-4000-8000-000000000008",
      "name": "Marcar erro"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://sfxbzfaxbbdjzuhzzrjc.supabase.co/rest/v1/criativos_drive?ad_name=eq.{{ encodeURIComponent($json.ad_name) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Profile",
              "value": "mkt_wep"
            },
            {
              "name": "Prefer",
              "value": "return=minimal"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.patch) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        1760,
        0
      ],
      "id": "c2000000-0000-4000-8000-000000000009",
      "name": "Atualizar registro",
      "credentials": {
        "supabaseApi": {
          "id": "5XZTPxZZN2ZzL1vn",
          "name": "Supabase PROD"
        }
      }
    },
    {
