# MODELO — este arquivo VAI para o Git. NUNCA coloque chaves reais aqui.
# Copie para .env.local (que é ignorado pelo Git) e preencha lá.
#
# REGRA: variáveis com prefixo VITE_ vão para o BUNDLE DO NAVEGADOR (públicas).
#        variáveis SEM o prefixo ficam SÓ NO SERVIDOR (/api/dashboard).

# ── CLIENTE (navegador) — só login ──────────────────────────────────────────
VITE_SUPABASE_AUTH_URL=https://SEU-PROJETO-AUTH.supabase.co
VITE_SUPABASE_AUTH_ANON_KEY=anon-key-do-projeto-de-auth

# ── SERVIDOR (nunca vai pro navegador) ──────────────────────────────────────
SUPABASE_URL=https://SEU-PROJETO-DADOS.supabase.co
SUPABASE_SERVICE_ROLE=service-role-do-projeto-de-dados   # ⚠️ SEGREDO
SUPABASE_AUTH_URL=https://SEU-PROJETO-AUTH.supabase.co
SUPABASE_AUTH_ANON_KEY=anon-key-do-projeto-de-auth

# ── ALLOWLIST — quem pode acessar o painel ──────────────────────────────────
# O login com Google cria conta automaticamente, então "estar logado" NÃO basta.
# Sem nenhuma das duas preenchidas, a API bloqueia todo mundo (falha fechada).
DASHBOARD_ALLOWED_DOMAINS=suaempresa.com.br
DASHBOARD_ALLOWED_EMAILS=pessoa@gmail.com,outra@gmail.com

# ── DEV: pular a tela de login ao ajustar o visual ──────────────────────────
# Só tem efeito em `npm run dev`: o cliente checa `import.meta.env.DEV` e a API
# checa `NODE_ENV !== 'production'`, então na Vercel isso é ignorado mesmo se
# estiver definido. Ligar = as duas em 1; religar o login = as duas em 0.
VITE_DEV_SKIP_AUTH=0
DEV_SKIP_AUTH=0
